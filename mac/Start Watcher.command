#!/bin/bash
# 双击我 = 在终端窗口里常驻运行守护
# 窗口保持开启即持续生效；关掉窗口/按 Ctrl-C 即停止
cd "$(dirname "$0")"
echo "==============================================="
echo "  手机摄像头守护运行中（每 8 秒检测一次）"
echo "  插上 USB 后会自动把 OBS 画面拉起来"
echo "  日志：$(pwd)/watch.log"
echo "  停止：关掉本窗口 或 按 Ctrl-C"
echo "==============================================="
exec ./phone-cam-watch.sh
